# Copy to .env and fill in. FORTIGATE_HOST and FORTIGATE_API_TOKEN are required.

# FortiGate management address (host or host:port). Example: 192.0.2.1 or fw01.corp.local:8443
FORTIGATE_HOST=

# REST API token (System > Administrators > REST API Admin > generate token)
FORTIGATE_API_TOKEN=

# VDOM to query (default: root)
FORTIGATE_VDOM=root

# Verify the FortiGate TLS cert. Set to true once you trust the cert/CA. Default: false (self-signed).
FORTIGATE_VERIFY_SSL=false

# HTTP timeout in seconds
FORTIGATE_TIMEOUT=15
